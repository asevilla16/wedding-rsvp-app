rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Wedding details (public read, authenticated or admin write)
    match /wedding/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Guest RSVP records
    match /guests/{guestId} {
      allow read: if true;
      allow write: if true;
    }

    // Guestbook wishes
    match /wishes/{wishId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Photo gallery
    match /photos/{photoId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
